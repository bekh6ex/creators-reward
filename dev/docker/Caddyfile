{
	admin off
	auto_https off
}

:18080 {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	@website1 host website1.crlocal
	reverse_proxy @website1 site1:8081

	@website2 host website2.crlocal
	reverse_proxy @website2 site2:8082

	@app host app.crlocal
	route @app {
		handle /api/* {
			reverse_proxy backend:8000
		}
		reverse_proxy viewer:5173
	}

	@creator host creator.crlocal
	route @creator {
		handle /api/* {
			reverse_proxy backend:8002
		}
		reverse_proxy creator:5174
	}

	@api host api.crlocal
	reverse_proxy @api backend:8000
}
